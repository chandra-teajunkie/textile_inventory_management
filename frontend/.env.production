REACT_APP_PORT=3005
BACKEND_PORT=3002
BACKEND_HOST=http://localhost

# Define the backend URL once
BACKEND_URL=${BACKEND_HOST}:${BACKEND_PORT}

REACT_APP_GET_ALL_ORDERS=${BACKEND_URL}/orders/
REACT_APP_POST_ALL_ORDERS=${BACKEND_URL}/orders/
REACT_APP_DELETE_ORDER=${BACKEND_URL}/orders/

REACT_APP_GET_ALL_TASKS=${BACKEND_URL}/tasks/?order_id=
REACT_APP_POST_ALL_TASKS=${BACKEND_URL}/tasks/
REACT_APP_PATCH_ALL_TASKS=${BACKEND_URL}/tasks/
REACT_APP_DELETE_TASK=${BACKEND_URL}/tasks/

REACT_APP_TASK_DETAILS=${BACKEND_URL}/tasks/task-details/
REACT_APP_INCOMING_CHART_UPLOAD=${BACKEND_URL}/tasks/incoming-chart-upload/
REACT_APP_OUTGOING_CHART_UPLOAD=${BACKEND_URL}/tasks/outgoing-chart-upload/